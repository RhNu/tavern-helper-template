{
  "name": "tavern-helper-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.ts --mode=production",
    "build:dev": "node tools/build.ts --mode=development",
    "build:scripts": "node tools/build.ts --mode=production --kind=scripts",
    "build:plugins": "node tools/build.ts --mode=production --kind=plugins",
    "watch": "node tools/build.ts --watch",
    "watch:plugins": "node tools/build.ts --watch --kind=plugins",
    "format": "oxfmt tools src util package.json tsconfig.json tsconfig.plugins.json tsconfig.tools.json postcss.config.ts oxlint.config.ts vitest.config.ts",
    "format:check": "oxfmt --check tools src util package.json tsconfig.json tsconfig.plugins.json tsconfig.tools.json postcss.config.ts oxlint.config.ts vitest.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "pnpm typecheck:scripts && pnpm typecheck:plugins && pnpm typecheck:tools",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.json",
    "typecheck:plugins": "tsc --noEmit -p tsconfig.plugins.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@pixi/react": "8.0.0-beta.25",
    "async-wait-until": "^2.0.31",
    "axios": "1.14.0",
    "compare-versions": "^6.1.1",
    "dedent": "^1.7.2",
    "gsap": "^3.15.0",
    "jquery": "^3.7.1",
    "jqueryui": "^1.11.1",
    "json5": "^2.2.3",
    "jsonrepair": "^3.15.0",
    "klona": "^2.0.6",
    "lodash": "^4.18.1",
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.6",
    "toastr": "^2.1.4",
    "yaml": "^2.9.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jquery": "^3.5.34",
    "@types/jqueryui": "^1.12.24",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/showdown": "^2.0.6",
    "@types/toastr": "^2.1.44",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "cac": "^7.0.0",
    "chokidar": "^5.0.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "postcss": "^8.5.28",
    "postcss-cli": "^11.0.1",
    "postcss-load-config": "^6.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-minify": "^1.2.0",
    "sass": "^1.104.0",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "tsdown": "0.23.0",
    "tslib": "^2.8.1",
    "type-fest": "^4.41.0",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "4.1.6"
  },
  "browserslist": [
    "defaults and partially supports es6-module"
  ],
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=12.3.0"
  },
  "packageManager": "pnpm@12.3.4"
}
