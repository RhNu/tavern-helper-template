{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["jquery", "jqueryui", "lodash", "toastr"],
    "target": "ESNext",
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/scripts/*"],
      "@shared/*": ["./src/shared/*"],
      "@util/*": ["./util/*"],
      "@scripts/*": ["./src/scripts/*"]
    },
    "moduleResolution": "bundler",
    "allowUmdGlobalAccess": true,
    "jsx": "react-jsx"
  },
  "include": ["@types", "examples/初始模板", "examples/示例", "src/scripts", "src/shared", "util", "*.d.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
